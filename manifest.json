{
  "manifestVersion": 1,
  "id": "tigexing",
  "name": "提个醒",
  "version": "0.4.35",
  "description": "替小花记住发弹窗的小喇叭。回复完成自动弹 Windows 通知，同窗口多条合并、跨窗口分开提醒，带静默时段和按助手个性化的音效与通知风格。",
  "trust": "full-access",
  "activationEvents": [
    "onStartup"
  ],
  "main": "index.js",
  "install": {
    "defaultEnabled": true
  },
  "capabilities": [
    "session",
    "model",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "127.0.0.1",
      "localhost",
      "api.commandcode.ai",
      "api.deepseek.com",
      "api.longcat.chat",
      "api.minimaxi.com",
      "api.moonshot.cn",
      "api.siliconflow.cn",
      "api.stepfun.com",
      "api.xiaomimimo.com",
      "apihub.agnes-ai.com",
      "ark.cn-beijing.volces.com",
      "chatgpt.com",
      "cli-chat-proxy.grok.com",
      "generativelanguage.googleapis.com",
      "note3-prev-api.askdiandian.com",
      "open.bigmodel.cn",
      "opencode.ai",
      "token.sensenova.cn"
    ],
    "methods": [
      "GET",
      "POST"
    ],
    "defaultTimeoutMs": 30000
  },
  "contributes": {
    "page": {
      "title": "提个醒",
      "route": "/page",
      "icon": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9'/><path d='M13.73 21a2 2 0 0 1-3.46 0'/></svg>"
    },
    "routes": [
      "./routes/api.js"
    ],
    "tools": [
      "./tools/test-notify.js"
    ]
  },
  "interface": {
    "displayName": "提个醒",
    "shortDescription": "回复完成自动弹窗提醒",
    "category": "Productivity",
    "author": "moononnn & 小花",
    "license": "MIT"
  }
}
